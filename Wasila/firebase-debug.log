[debug] [2026-06-05T10:36:42.053Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/wasila-de239/rulesets {"name":"projects/wasila-de239/rulesets/ea20b06f-138d-4873-b5e2-71a7705c8e2f","source":{"files":[{"content":"rules_version = '2';\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    \r\n    // Allow anyone to search/read services, but only authenticated users can write\r\n    match /services/{document=**} {\r\n      allow read, write: if true;\r\n    }\r\n\r\n    // Allow anyone to read/write bookings (used by backend/agents and frontend)\r\n    match /bookings/{document=**} {\r\n      allow read, write: if true;\r\n    }\r\n\r\n    // Allow anyone to read/write chats (used by backend/agents and frontend)\r\n    match /chats/{document=**} {\r\n      allow read, write: if true;\r\n    }\r\n\r\n    // Allow anyone to read/write user profiles\r\n    match /users/{document=**} {\r\n      allow read, write: if true;\r\n    }\r\n\r\n    // Allow anyone to read/write notifications (used by backend/agents and frontend)\r\n    match /notifications/{document=**} {\r\n      allow read, write: if true;\r\n    }\r\n\r\n    // Default rule for all other collections\r\n    match /{document=**} {\r\n      // Sirf authenticated users ko read/write allow karein\r\n      allow read, write: if request.auth != null;\r\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-06-05T10:36:42.464799Z","metadata":{"services":["cloud.firestore"]}}
